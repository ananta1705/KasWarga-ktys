# =========================================================================
# KONFIGURASI ENVIRONMENT KASWARGA
# =========================================================================
# Cara Penggunaan:
# 1. Salin isi file ini ke dalam pengaturan Environment Variables di layanan hosting Anda (misal: Vercel)
# 2. Atau jika dijalankan lokal, buat file baru bernama `.env.local` dan tempel isi file ini
# 3. Ganti nilai-nilai di bawah ini dengan kredensial Anda yang sebenarnya.

# 1. KATA SANDI PENGURUS RT
# Digunakan untuk login ke halaman admin dan mengelola data.
ADMIN_PASSWORD=kertayasajaya

# 2. KREDENSIAL GOOGLE SERVICE ACCOUNT
# Dapatkan kredensial ini dari Google Cloud Console dengan mengaktifkan Google Sheets API
# dan membuat Service Account. 
# PENTING: Untuk GOOGLE_SHEETS_PRIVATE_KEY, pastikan seluruh baris menyatu dan menggunakan \n 
# sebagai ganti baris baru asli, lengkap dengan -----BEGIN PRIVATE KEY----- dan -----END PRIVATE KEY-----

GOOGLE_SHEETS_CLIENT_EMAIL=nama-service-account@nama-project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk... (ISI DENGAN KEY ANDA) ...\n-----END PRIVATE KEY-----\n"

# 3. ID SPREADSHEET GOOGLE
# Dapatkan ID ini dari URL Google Sheets Anda.
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0X_5B3wXYZ123/edit
# ID-nya adalah: 1BxiMVs0X_5B3wXYZ123
GOOGLE_SHEETS_SPREADSHEET_ID=masukkan_id_spreadsheet_anda_disini
